{
  "name": "artemis-consumer",
  "version": "1.0.0",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "build:electron": "tsc && cp src/electron/index.html dist/electron/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "send": "ts-node src/index-send.ts",
    "send:build": "npm run build && node dist/index-send.js",
    "consumer": "ts-node src/index.ts",
    "consumer:build": "npm run build && node dist/index.js",
    "send:js": "node index-send.js",
    "consumer:js": "node index.js",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build": "npm run build:electron && electron-builder --win --x64",
    "electron:build:portable": "npm run build:electron && electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^17.1.0",
    "stompit": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "png-to-ico": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.artemis.stomp",
    "productName": "Artemis STOMP Client",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "universal"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "src/electron/icon.webp"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
